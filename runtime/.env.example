# OH Ventures runtime
OHV_ENV=development
OHV_DB_PATH=./data/ohv.db
OHV_ARTIFACT_DIR=./data/artifacts
OHV_LOG_LEVEL=INFO
OHV_SHADOW_MODE=true

# Local inference (Ollama or any OpenAI-compatible local server)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=

# TrendTrack
TRENDTRACK_API_KEY=
TRENDTRACK_BASE_URL=https://api.trendtrack.io

# Frontier providers (optional until escalation is enabled)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Notifications (optional)
MORNING_BRIEF_WEBHOOK_URL=
